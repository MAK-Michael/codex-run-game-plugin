{
  "name": "codex-run",
  "version": "0.1.0",
  "description": "A Codex-themed pixel runner that plays directly inside chat.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MAK-Michael/codex-run-game-plugin.git",
    "directory": "plugins/codex-run"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:ui && npm run build:server",
    "build:ui": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server/index.js",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.1.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
