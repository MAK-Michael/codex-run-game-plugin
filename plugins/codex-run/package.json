{
  "name": "codex-run",
  "version": "0.1.0",
  "description": "A Codex-themed pixel runner that plays directly inside chat.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MAK-Michael/codex-run-game-plugin.git",
    "directory": "plugins/codex-run"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "build": "pnpm run build:prod",
    "build:all": "pnpm run build:ui && pnpm run build:server",
    "build:dev": "CODEX_RUN_LEADERBOARD_ORIGIN=https://codex-run-leaderboard-dev.michael-ef6.workers.dev pnpm run build:all",
    "build:prod": "CODEX_RUN_LEADERBOARD_ORIGIN=https://codex-run-leaderboard-prod.michael-ef6.workers.dev pnpm run build:all",
    "build:ui": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "dev": "CODEX_RUN_LEADERBOARD_ORIGIN=https://codex-run-leaderboard-dev.michael-ef6.workers.dev vite",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "verify": "pnpm run typecheck && pnpm test && pnpm run build",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.1.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
