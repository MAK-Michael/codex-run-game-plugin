{
  "description": "Inject the Codex Run auto-start preference before every user turn.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/user-prompt-submit.mjs\"",
            "timeout": 3,
            "additionalContextLimit": 500
          }
        ]
      }
    ]
  }
}
